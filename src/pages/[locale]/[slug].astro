---
import PageView from "../../components/PageView.astro";
import { getLocales } from "../../lib/locales";
import { getPage, getPages, PAGE_SLUG_PATTERN } from "../../lib/payload";
import { withHubLinks } from "../../lib/services";

export async function getStaticPaths() {
  const locales = await getLocales();
  const paths = [];
  for (const locale of locales) {
    const pages = await getPages(locale.code);
    for (const page of pages) {
      if (page.slug !== "home") paths.push({ params: { locale: locale.code, slug: page.slug } });
    }
  }
  return paths;
}

const { locale, slug } = Astro.params;
if (!locale || !slug || slug === "home" || !PAGE_SLUG_PATTERN.test(locale) || !PAGE_SLUG_PATTERN.test(slug) || slug.length > 80) return Astro.redirect("/404");
const found = await getPage(slug, locale);
if (!found) return Astro.redirect("/404");
// A hub page (e.g. /service-areas) lists its published entries.
const page = await withHubLinks(found);
---

<PageView locale={locale} slug={slug} page={page} />
