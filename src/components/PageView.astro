---
import Layout from "../layouts/Layout.astro";
import InlinePreviewBootstrap from "./InlinePreviewBootstrap.astro";
import { getSiteGlobals, cmsOrigin as payloadURL, globalSlug as payloadGlobalSlug, type Page, type SiteGlobals } from "../lib/payload";
import { isSharedSection } from "@good-shepherd-insights/website-components/core";
import { SectionRenderer } from "@good-shepherd-insights/website-components/react";
import { buildSiteGraph } from "../lib/seo/schemaGraph";
import { getServiceIndex, withNavbarAreas, type ServicePage } from "../lib/services";

interface Props {
  locale: string;
  slug: string;
  page: Page;
  // Preview passes the draft site global; the public build reads the published one.
  site?: SiteGlobals;
  // CMS collection the page comes from (pages, or a service type), for the live-preview bridge.
  collection?: string;
  // A previewed global whose `sections` this page shows (a service type's globals).
  documentGlobal?: string;
  // Keep this page out of search results ("noindex, follow").
  noindex?: boolean;
  // Meta description of a service page (pages use their metadata.description).
  description?: string;
  // A service in a service area: its Service structured data.
  service?: ServicePage["service"];
}

const { locale, page: content } = Astro.props;
const site = Astro.props.site ?? await getSiteGlobals(locale);
const title = content.metadata.titleTemplate.replace("{title}", content.title);
// Never the title: with no description set, none is published.
const description = (Astro.props.description ?? content.metadata.description)?.trim() || undefined;
// Real, standard skip-navigation link text — not CMS content. The
// SiteGlobals "accessibility" group this used to read from had 4 of its 5
// fields entirely unused anywhere in this codebase and was removed; this
// is the one real feature it backed, kept as a literal (same pattern as
// Contact Us's "Next Week"/"Current Week" — fixed UI chrome text, not
// business content that varies per site).
const skipToContentLabel = "Skip to main content";
// Real fix: Navbar/Footer are real sitewide defaults (SiteGlobals.
// components), not one-off page blocks — every page gets them unless it
// explicitly opts out via its own hiddenGlobalComponents. Real document-
// structure requirement: Navbar (and the skip-link, which must be the
// first focusable element before it) renders before <main>; Footer (and
// anything else here) renders after — via Layout.astro's named "navbar"/
// "footer" slots, not array order.
const hiddenIds = new Set((content.hiddenGlobalComponents ?? []).map(String));
const globalSectionEntries = site.components.flatMap((entry, componentIndex) => {
  const resolved = entry.component;
  if (!resolved || typeof resolved !== "object") return [];
  if (hiddenIds.has(String(resolved.id))) return [];
  return (resolved.sections ?? []).map((section, sectionIndex) => ({ componentIndex, sectionIndex, section }));
});
const siteOrigin = Astro.site ?? Astro.url;
const jsonLd = buildSiteGraph({
  site,
  canonical: new URL(Astro.url.pathname, siteOrigin).toString(),
  baseUrl: new URL("/", siteOrigin).toString(),
  title,
  description,
  locale,
  // The page's sections plus its sitewide ones (navbar, footer…).
  sections: [...content.sections, ...globalSectionEntries.map(({ section }) => section)],
  // Service and service-area pages (payload-plugin-services types) are about a service.
  isServicePage: Boolean(Astro.props.collection && Astro.props.collection !== "pages"),
  service: Astro.props.service,
});
// The navbar's service areas menu lists the published service areas.
const serviceIndex = await getServiceIndex();
const navbarEntries = globalSectionEntries
  .filter(({ section }) => section.blockType === "navbar")
  .map((entry) => ({ ...entry, section: withNavbarAreas(entry.section, serviceIndex) }));
const footerEntries = globalSectionEntries.filter(({ section }) => section.blockType !== "navbar");
---

<Layout title={title} description={description} locale={locale} favicon={site.brand.favicon?.url} image={site.brand.ogImage?.url ?? site.brand.logo?.url} imageAlt={(site.brand.ogImage ? site.brand.ogImage.alt : site.brand.logoAlt) ?? ""} jsonLd={jsonLd} noindex={Astro.props.noindex}>
  <Fragment slot="navbar">
    {skipToContentLabel && <a class="skip-link" href="#main-content">{skipToContentLabel}</a>}
    {navbarEntries.map(({ componentIndex, sectionIndex, section }) => {
      const prefix = `components.${componentIndex}.component.${sectionIndex}`;
      if (isSharedSection(section)) return <SectionRenderer section={section} pathPrefix={prefix} />;
      return (
        <section data-component={componentIndex} data-section={section.blockType} data-section-index={sectionIndex}>
          {section.blockType}
        </section>
      );
    })}
  </Fragment>
  <div data-inline-preview-root data-payload-server-url={payloadURL} data-payload-global-slug={payloadGlobalSlug} data-payload-collection="pages" data-payload-id={content.id} data-locale={locale}>
    <main id="main-content" tabindex="-1">
      {content.sections.map((section, index) => {
        const prefix = `sections.${index}`;
        if (isSharedSection(section)) return <SectionRenderer section={section} pathPrefix={prefix} />;
        return (
          <section data-section={section.blockType} data-section-index={index}>
            {section.blockType}
          </section>
        );
      })}
    </main>
  </div>
  <Fragment slot="footer">
    {footerEntries.map(({ componentIndex, sectionIndex, section }) => {
      const prefix = `components.${componentIndex}.component.${sectionIndex}`;
      if (isSharedSection(section)) return <SectionRenderer section={section} pathPrefix={prefix} />;
      return (
        <section data-component={componentIndex} data-section={section.blockType} data-section-index={sectionIndex}>
          {section.blockType}
        </section>
      );
    })}
  </Fragment>
</Layout>

<InlinePreviewBootstrap collection={Astro.props.collection ?? "pages"} documentGlobal={Astro.props.documentGlobal} initialData={content} initialGlobalData={site} locale={locale} globalSlug={payloadGlobalSlug} />
